{
  "expo": {
    "name": "SmartTab - Guitar Karaoke",
    "slug": "guitar-karaoke",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.guitarkaraoke.smarttab",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "SmartTab needs access to your microphone to listen to your guitar playing and provide real-time feedback.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-av",
        {
          "microphonePermission": "Allow SmartTab to access your microphone for guitar pitch detection."
        }
      ],
      "expo-font"
    ]
  }
}
